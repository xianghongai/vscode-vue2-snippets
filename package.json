{
  "name": "vscode-vue2-snippets",
  "displayName": "Vue 2 Snippets",
  "version": "2.6.0",
  "description": "Code snippets for Vue 2 (Only Vue 2.x, Vue Router 3.x, @vue/composition-api)",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "Snippet",
    "Vue",
    "Vue 2",
    "Vue 2 Code Snippets",
    "Vue 2 Snippet",
    "Vue 2 Snippets",
    "Vue Router",
    "Vue Snippet",
    "Vue Snippets",
    "Vue2",
    "Vue2 Code Snippets",
    "Vue2 Snippet",
    "Vue2 Snippets",
    "Vuex"
  ],
  "homepage": "https://github.com/xianghongai/vscode-vue2-snippets/",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-vue2-snippets/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-vue2-snippets/blob/main/README.md"
  },
  "publisher": "NicholasHsiang",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "rimraf --glob \"*.vsix\" snippets",
    "dev": "node --watch-path=src scripts/build.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint scripts tests",
    "test": "vitest run",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "pnpm run clean && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vscode/vsce": "^3.9.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "picocolors": "^1.1.1",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.11"
  },
  "contributes": {
    "snippets": [
      {
        "path": "./snippets/index.code-snippets"
      }
    ]
  },
  "icon": "art/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.25.0"
}
