{
  "<router-link>, literal string": {
    "prefix": "router-link",
    "body": ["<router-link to=\"$1\">", "  $2", "</router-link>$0"],
    "description": "Router link with literal string.\n",
    "scope": "vue,html"
  },
  "<router-link>, v-bind": {
    "prefix": "router-link",
    "body": ["<router-link :to=\"$1\">", "  $2", "</router-link>$0"],
    "description": "Router link using `v-bind`.\n",
    "scope": "vue,html"
  },
  "<router-link>, exact": {
    "prefix": "router-link-exact",
    "body": ["<router-link :to=\"$1\" exact>", "  $2", "</router-link>$0"],
    "scope": "vue,html"
  },
  "<router-link>, path": {
    "prefix": "router-link-path",
    "body": ["<router-link :to=\"{ path: ${1:'${2:pathname}'} }\">", "  $3", "</router-link>$0"],
    "description": "Router link to path.\n",
    "scope": "vue,html"
  },
  "<router-link>, path, params": {
    "prefix": "router-link-path-params",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    path: '${1:pathname}',",
      "    params: { ${2:property}: ${3:'value'} },",
      "  }\"",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to path with params.\n",
    "scope": "vue,html"
  },
  "<router-link>, path, query": {
    "prefix": "router-link-path-query",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    path: '${1:pathname}',",
      "    query: { ${2:property}: ${3:'value'} },",
      "  }\"",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to path with query.\n",
    "scope": "vue,html"
  },
  "<router-link>, path, params, query": {
    "prefix": "router-link-path-params-query",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    path: '${1:pathname}',",
      "    params: { ${2:property}: ${3:'value'} },",
      "    query: { ${4:property}: ${5:'value'} },",
      "  }\"",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to path with query.\n",
    "scope": "vue,html"
  },
  "<router-link>, path, append": {
    "prefix": "router-link-path-append",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    path: '${1:pathname}',",
      "  }\"",
      "  append",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to path, append mode.\n",
    "scope": "vue,html"
  },
  "<router-link>, path, replace": {
    "prefix": "router-link-path-replace",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    path: '${1:pathname}',",
      "  }\"",
      "  replace",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to path, replace mode.\n",
    "scope": "vue,html"
  },
  "<router-link>, named": {
    "prefix": "router-link-named",
    "body": ["<router-link :to=\"{ name: ${1:'${2:routeName}'} }\">", "  $3", "</router-link>$0"],
    "description": "Router link to named route.\n",
    "scope": "vue,html"
  },
  "<router-link>, named, params": {
    "prefix": "router-link-named-params",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    name: '${1:routeName}',",
      "    params: { ${2:property}: ${3:'value'} },",
      "  }\"",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to named route with params.\n",
    "scope": "vue,html"
  },
  "<router-link>, named, query": {
    "prefix": "router-link-named-query",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    name: '${1:routeName}',",
      "    query: { ${2:property}: ${3:'value'} },",
      "  }\"",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to named route with query.\n",
    "scope": "vue,html"
  },
  "<router-link>, named, params, query": {
    "prefix": "router-link-named-params-query",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    name: '${1:routeName}',",
      "    params: { ${2:property}: ${3:'value'} },",
      "    query: { ${4:property}: ${5:'value'} },",
      "  }\"",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router link to named route with query.\n",
    "scope": "vue,html"
  },
  "<router-link>, named, append": {
    "prefix": "router-link-named-append",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    name: '${1:routeName}',",
      "  }\"",
      "  append",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router Link to named route, append mode.\n",
    "scope": "vue,html"
  },
  "<router-link>, named, replace": {
    "prefix": "router-link-named-replace",
    "body": [
      "<router-link",
      "  :to=\"{",
      "    name: '${1:routeName}',",
      "  }\"",
      "  replace",
      ">",
      "  $0",
      "</router-link>"
    ],
    "description": "Router Link to named route, replace mode.\n",
    "scope": "vue,html"
  },
  "router params": {
    "prefix": "router-params",
    "body": ["params: {", "  ${1:property}: ${2:'value'},$3", "},"],
    "description": "router with params.\n",
    "scope": "vue,html"
  },
  "router query": {
    "prefix": "router-query",
    "body": ["query: {", "  ${1:property}: ${2:'value'},$3", "},"],
    "description": "router with query.\n",
    "scope": "vue,html"
  }
}
